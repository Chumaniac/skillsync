{
  "version": 1,
  "name": "SkillSync",
  "identifier": "com.chumaniac.skillsync",
  "mark": "SS",
  "port": 19002,
  "smokePort": 19012,
  "mode": "process",
  "readySelector": "main",
  "closeGuardSelector": "#verify:disabled",
  "launch": {
    "executable": "{{NODE}}",
    "arguments": [
      "{{REPO}}/dist/cli/index.js",
      "gui",
      "--state-dir",
      "{{HOME}}/Library/Application Support/SkillSync/workspace",
      "--port",
      "19002"
    ],
    "workingDirectory": "{{REPO}}",
    "healthPath": "health",
    "healthMarker": "skillsync-workbench",
    "stopOnQuit": true,
    "smokeArguments": [
      "{{REPO}}/dist/cli/index.js",
      "gui",
      "--state-dir",
      "{{SMOKE_DIR}}/state",
      "--port",
      "19012"
    ]
  }
}
