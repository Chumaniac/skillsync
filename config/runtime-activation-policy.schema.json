{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsync.dev/schemas/runtime-activation-policy.v1.json",
  "title": "SkillSync Runtime Activation Policy Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "trustBundleJson"],
  "properties": {
    "source": {
      "const": "deployment-config"
    },
    "trustBundleJson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    }
  }
}
