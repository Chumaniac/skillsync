{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsync.dev/schemas/runtime-deployment-requirements.v1.json",
  "title": "SkillSync Runtime Deployment Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "liveCapabilitiesEnabled", "activation", "worker", "controlledEnvironment", "rollback"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "deployment-config" },
    "liveCapabilitiesEnabled": { "const": false },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "rootPin", "entrypoints"],
      "properties": {
        "order": {
          "type": "array",
          "prefixItems": [
            { "const": "egress" },
            { "const": "provider-credentials" },
            { "const": "docker-microvm" },
            { "const": "remote-worker" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "rootPin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "keyId", "fingerprint"],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^deployment-key-store://[A-Za-z0-9._~:/-]+$",
              "not": { "pattern": "(^|/)\\.\\.?(/|$)" },
              "maxLength": 256
            },
            "keyId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["egress", "provider-credentials", "docker-microvm", "remote-worker"],
          "properties": {
            "egress": { "$ref": "#/$defs/entrypoint" },
            "provider-credentials": { "$ref": "#/$defs/entrypoint" },
            "docker-microvm": { "$ref": "#/$defs/entrypoint" },
            "remote-worker": { "$ref": "#/$defs/entrypoint" }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "identity", "receipt"],
      "properties": {
        "mode": { "const": "secure" },
        "identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "reference"],
              "properties": {
                "source": { "const": "deployment-key-store" },
                "reference": {
                  "type": "string",
                  "pattern": "^deployment-key-store://[A-Za-z0-9._~:/-]+$",
                  "not": { "pattern": "(^|/)\\.\\.?(/|$)" },
                  "maxLength": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "reference"],
              "properties": {
                "source": { "const": "mtls" },
                "reference": {
                  "type": "string",
                  "pattern": "^mtls://[A-Za-z0-9._~:/-]+$",
                  "not": { "pattern": "(^|/)\\.\\.?(/|$)" },
                  "maxLength": 256
                }
              }
            }
          ]
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "maxTtlSeconds", "cleanupRequired"],
          "properties": {
            "required": { "const": true },
            "maxTtlSeconds": { "const": 3600 },
            "cleanupRequired": { "const": true }
          }
        }
      }
    },
    "controlledEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "network", "egress", "credentials", "hostMounts", "docker", "microvm", "publicEvidence"],
      "properties": {
        "runner": { "const": "controlled-ci" },
        "network": { "const": "isolated" },
        "egress": { "const": "deny-by-default" },
        "credentials": { "const": "external-reference-only" },
        "hostMounts": { "const": "none" },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["daemon", "baseImages", "pull", "socketMount", "network"],
          "properties": {
            "daemon": { "const": "controlled-ci-only" },
            "baseImages": { "const": "preseeded-only" },
            "pull": { "const": "forbidden" },
            "socketMount": { "const": "forbidden" },
            "network": { "const": "deny" }
          }
        },
        "microvm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution", "network", "hostMounts"],
          "properties": {
            "execution": { "const": "controlled-ci-only" },
            "network": { "const": "deny-by-default" },
            "hostMounts": { "const": "forbidden" }
          }
        },
        "publicEvidence": { "const": "bounded-redacted" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "target", "triggers"],
      "properties": {
        "enabled": { "const": true },
        "target": { "const": "existing-fail-closed-backend" },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": ["receipt-missing", "credential-leak", "network-policy-regression", "teardown-incomplete", "untrusted-artifact"]
          }
        }
      }
    }
  },
  "$defs": {
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "enforcement", "implementation"],
      "properties": {
        "boundary": { "const": "runtime-activation-boundary" },
        "enforcement": { "const": "required" },
        "implementation": { "const": "not-enabled" }
      }
    }
  }
}
